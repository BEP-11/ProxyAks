# Quick-start environment variables для ProxyAks
# Скопируйте в .env и настройте под себя

# Host и порт HTTP-сервера
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# Порт HTTPS (шифрованное входящее подключение)
PROXY_TLS_PORT=8443
PROXY_ENABLE_TLS=true

# Белый список доменов (пусто = разрешены все)
# PROXY_WHITELIST=google.com,yandex.ru,github.com

# Чёрный список доменов
# PROXY_BLACKLIST=ads.example.com,tracker.bad-domain.com
